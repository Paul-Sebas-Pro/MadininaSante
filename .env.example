# Copier vers .env.local et renseigner. Ne jamais committer .env.local

# URL publique du site (utilisée pour metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase — projet : https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé service role (serveur uniquement — scripts d'import, tâches admin)
SUPABASE_SERVICE_ROLE_KEY=""

# Connexion Postgres directe (pooler Supabase, mode "session" ou "transaction")
# ex: postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=""
