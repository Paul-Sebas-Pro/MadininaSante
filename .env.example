# Copier vers .env.local (ou .env) et renseigner. Ne jamais committer.

# URL publique du site (metadata, sitemap, OG). En prod = URL Vercel.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase — Project settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé service role (serveur uniquement — scripts d'import, tâches admin)
SUPABASE_SERVICE_ROLE_KEY=""

# Connexion Postgres pour l'app (runtime serverless) :
# Supabase > Connect > "Transaction pooler" (port 6543). prepare:false est géré dans src/db.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Pour appliquer les migrations DDL, utiliser le "Session pooler" (port 5432) :
#   psql "$(echo $DATABASE_URL | sed 's/:6543/:5432/')" -f supabase/migrations/0001_init.sql
